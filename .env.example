# Node 24.14+. Copy to .env; use long, distinct credentials.
PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/mandate.sqlite
OWNER_PASSWORD=
AGENT_API_KEY=
# Optional until running the live integration gate. Sandbox only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set to true only behind HTTPS (required outside localhost).
COOKIE_SECURE=false
